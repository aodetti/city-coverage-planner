# Private, deployment-specific data (real city maps, notes, etc.).
/local/

# macOS finder metadata
.DS_Store

# Go build artifacts (compiled binaries live at the project root).
/bin/
*.tmp

# Built frontend bundle embedded into the Go binary (regenerated by `make`).
# The placeholder index.html is kept; real build output is ignored.
/backend/internal/web/dist/assets/
/frontend/dist/
/frontend/node_modules/

# Local Claude Code settings (machine-specific paths, permissions).
.claude/settings.local.json

# Local dev launch config (machine-specific paths).
.claude/launch.json
